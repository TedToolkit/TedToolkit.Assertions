<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="CodeAnalysis.props" Sdk="TedToolkit.Build.Sdk"/>
  <Import Project="NugetPackage.props" Sdk="TedToolkit.Build.Sdk"/>
  <Import Project="AlmostAllFrameworks.props" Sdk="TedToolkit.Build.Sdk"/>

  <PropertyGroup>
    <Title>Assertion.FluentValidation</Title>
    <Description>Use this package with Fluent Validation</Description>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="Localizations\Localization*.json"/>
    <PackageReference Include="FluentValidation"/>
    <ProjectReference Include="..\TedToolkit.Assertions\TedToolkit.Assertions.csproj"/>
    <Analyzer Include="..\TedToolkit.Assertions.Analyzer\bin\$(Configuration)\netstandard2.0\TedToolkit.Assertions.Analyzer.dll"/>
    <Analyzer Include="..\TedToolkit.Assertions.Analyzer\bin\$(Configuration)\netstandard2.0\TedToolkit.RoslynHelper.dll"/>
    <Analyzer Include="..\TedToolkit.Assertions.Analyzer\bin\$(Configuration)\netstandard2.0\ZString.dll"/>
    <Analyzer Include="..\TedToolkit.Assertions.Analyzer\bin\$(Configuration)\netstandard2.0\System.Memory.dll"/>
  </ItemGroup>
</Project>
